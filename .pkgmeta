# RGX-Framework Package Metadata
# Used by BigWigsMods packager (GitHub Actions release workflow)

package-as: RGX-Framework

# License file (LICENSE.txt at repo root; TOC declares X-License: MIT)
license: LICENSE.txt

# Files and folders excluded from the packaged zip.
# NOTE: directory entries must NOT have a trailing slash — the packager's
# matcher treats "docs/" and "docs" differently, and the slash form silently
# fails (verified against the v2.2.0 zip, which leaked docs/schemas/tools).
# Fonts are committed under media/fonts/ — no download step is required.
ignore:
  - .gitignore
  - .mcp.json
  - CLAUDE.md
  - Home.md
  - README.md
  - docs
  - schemas
  - graphify-out
  - .agents
  - .claude

# tools/rgx-mcp intentionally ships in the packaged zip: addon authors who
# install RGX-Framework and want to build their own addon on it should
# already have the framework's MCP server (validate/audit/generate against
# schemas/rgx-addon.schema.json) on hand, not need a separate download.

# Release notes come from the canonical changelog summary.
manual-changelog:
  filename: docs/CHANGES.md
  markup-type: markdown
